# HakiOS fragment: the OnePlus 13 (dodge) -- what is true of this device and of no other.
# What has been SEEN WORKING on this phone (October 2026; see PORTING NOTES in README.md):
# a boot to SpringBoard through the loader's framebuffer, all buttons, the Synaptics S3910 touch
# screen (multitouch, 125 Hz), the audio DSP's PAS bring-up steps (staged arguments below), and the
# WCN7850's PCIe read-only probe. Everything else (GPU, sound out, Wi-Fi as a network, storage,
# modem, camera, haptic) is not brought up here yet, and left OUT of the kernel, not just off.
CONFIG_DEVICE="dodge"

# ---- what is built in --------------------------------------------------------------------------------
# the buttons: power from the PON, volume down from PM8550VS GPIO6 through the arbiter's v7/v8
# layout (the SM8750's), volume up from the PON's resin key (buttons_swap -- this phone's wiring
# is the reverse of the reference's)
CONFIG_HAKIOS_BUTTONS=y
# the touch screen: this phone's own driver (drivers/input/conf in this repository)
CONFIG_HAKIOS_DODGE_TOUCH=y
# the audio DSP's bring-up (adsp=1 with the staged arguments below); the battery's state would
# come through it, but that has not been seen on this phone yet
CONFIG_HAKIOS_ADSP=y
# the WCN7850's PCIe bring-up probe, in stages (wifi_pcie=1: read only)
CONFIG_HAKIOS_WCN=y

# ---- the arguments of what is built in -----------------------------------------------------------------
# the working boot: four cores (the proven configuration; the loader's platform_dodge numbers all
# eight, and cpus=8 has been seen to work too -- when the run is to try it, override on the command line)
CONFIG_CPUS=4
# the buttons: GPIO6 of the PM8550VS is peripheral 0x8d of slave 1 (0x18d), APID 610 owner EE 0;
# the firmware of this chain leaves the pin unconfigured, and the driver enables it through the
# arbiter's write side. buttons_swap=1: resin is volume UP and the GPIO key volume DOWN here.
CONFIG_BUTTONS=y
# the touch screen (synaptics=1 in CONFIG_BOOTARGS turns the driver on)
# the audio DSP, in the staging this phone's PAS bring-up was proven with: no IPCC doorbell enables
# (an unhandled interrupt storm hangs the kernel -- the doorbells are polled), the doorbells' and
# the sequencer's GIC lines masked, the DDR bus clock managers voted to maximum first, and this
# phone's shared memory, DSP memory, command database, sequencer and IPCC windows (the SM8750's own
# addresses; the kernel's defaults are the reference phone's and reading them aborts)
# CONFIG_ADSP is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_NOIPCC is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_GICMASK is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_BW is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_SMEM is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_SMEM_SIZE is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_MEM is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_SIZE is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_CMDDB is not set   # (adsp_cmddb=0x81c60000 when the audio DSP is tried again)
# CONFIG_ADSP_RSC is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# CONFIG_ADSP_IPCC is not set   # (the audio DSP waits on the Gunyah wall; the arguments stay for the day it does not)
# the WCN7850's PCIe: stage 1 reads what the boot loaders left (pins, GDSCs, clock branches) and
# writes nothing. Stages 2 and up (wifi_pcie=2 ...) belong to the bring-up runs, not to this
# configuration.
# CONFIG_WIFI_PCIE is not set

# ---- what is left out ----------------------------------------------------------------------------------
# (every driver whose hardware has not been brought up here; the tool wrote the list out, and it
# stays: the addresses inside each of them are the reference phone's)
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
CONFIG_HAKIOS_ADRENO8=y
CONFIG_HAKIOS_GPU_SERVICE=y
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_UFS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE="device" (the common kernel's own value): the audio DSP's firmware is pulled from
# this phone with pull-firmware.sh into fw-audio/; nothing else here loads firmware

# the GPU bring-up set: 23 stages, the service, the PLL clock, the secure handover
# (needs an Android cold settle first; see drivers/gpu/conf for every condition).
# touchscreen=0 wfi=0 wfe_mode=0 are REQUIRED alongside the adreno8 set: the ARC clock
# votes of adreno8_rpmh.c refuse to run unless all three are explicitly zero
# (they say "the diagnostic has no sleep/wake cache"; touch is synaptics=1, a different
# driver and argument, so the two do not conflict).
CONFIG_BOOTARGS="cpus=4 synaptics=1 buttons=1 buttons_pin=0x18d buttons_swap=1 touchscreen=0 wfi=0 wfe_mode=0 adreno8=23 adreno8_keep=1 adreno8_return=0 adreno8_gmuclk=2 adreno8_secure_preflight=4"
