# The kernel arguments this device needs beyond the common ones: the launcher
# (launcher/hackios.py) and tools/modem-cycle.sh merge this file into the
# command line. pull-soc.sh regenerates soc.args, so the device's own arguments
# live here instead.
#
#   synaptics=1        the touch screen (the S3910 driver)
#   buttons_pin=0x18d  the volume-down key's PMIC GPIO: slave 1 (PM8550),
#                      GPIO6 -- its registers 0x8d00 of that slave (0x18e is
#                      GPIO7, another execution environment's channel: writing
#                      it faults the kernel).  The firmware leaves the pin
#                      disabled; the driver enables it through the arbiter's
#                      chnls side (APID 610, owner EE 0, as the touch driver's)
#   buttons_swap=1     the PON's resin key is volume UP here and the GPIO one
#                      volume DOWN (the POCO X5 Pro's wiring is the reverse)
synaptics=1 buttons=1 buttons_pin=0x18d buttons_swap=1
