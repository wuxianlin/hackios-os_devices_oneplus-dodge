--- a/src/gallium/drivers/freedreno/a6xx/fd6_draw.cc	2026-10-23 14:36:12
+++ b/src/gallium/drivers/freedreno/a6xx/fd6_draw.cc	2026-10-23 14:12:27
@@ -488,6 +488,27 @@
        DRAW == DRAW_INDIRECT_OP_INDIRECT_COUNT)
       ctx->batch->barrier |= FD6_WAIT_FOR_ME;
 
+   /* Darwin on redwood: a draw that reads the framebuffer reads it through
+    * UCHE.  Among primitives drawn with FLUSH_PER_OVERLAP the hardware sees
+    * to it that they read what the ones before them wrote, but it knows
+    * nothing of what was drawn before that mode was on: the first triangle
+    * to read the framebuffer after a draw that did not, read (with GMEM)
+    * pixels of another tile.  Seen on a642l with CoreAnimation, which draws
+    * a label's shadow that way over icons drawn the ordinary way: the first
+    * triangle of each such quad was wrong, the second right.  A CCU colour
+    * flush before the draw mends it, and so does a UCHE invalidate alone;
+    * the first such draw gets both, as a framebuffer barrier would give.
+    * On a8xx (a830, annibale) the read also goes through CCHE: with only
+    * those two, the first triangle still showed pixels of the other GMEM
+    * bin, until CCHE was invalidated as well.
+    */
+   if (unlikely(emit.fs->fb_read) && !ctx->batch->prev_draw_read_fb) {
+      ctx->batch->barrier |= FD6_FLUSH_CCU_COLOR | FD6_INVALIDATE_CACHE;
