+ * OTHER DEALINGS IN THE SOFTWARE.
+ */
+
+
+#include "target-helpers/inline_sw_helper.h"
+#include "target-helpers/inline_debug_helper.h"
+
+#include "sw/null/null_sw_winsys.h"
+
+#include "frontend/winsys_handle.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#ifdef GALLIUM_FREEDRENO
+#include "freedreno/drm/freedreno_drm_public.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include <xf86drm.h>
+
+static int gpu_fd = -1;
+
+static const driOptionDescription freedreno_options[] = {
+#include "freedreno/driinfo_freedreno.h"
+};
+
+/* The GPU's driver, where the kernel has a GPU to drive (Darwin on redwood); NULL: none. */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, freedreno_options, ARRAY_SIZE(freedreno_options));
+   const driConfigFileParseParams params = {
+      .screenNum = 0,
+      .driverName = "msm",
+   };
+   driParseConfigFiles(&cache, &info, &params);
+   config.options = &cache;
+   config.options_info = &info;
+   screen = fd_drm_screen_create_renderonly(fd, NULL, &config);
+   if (screen)
+      gpu_fd = fd;
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+#endif
+
+
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
+
+/*
+ * The memory of an IOSurface as a texture, to draw into and to draw with (Darwin on redwood):
+ * the kernel's GPU driver makes a buffer of the surface. NULL: the screen is not the GPU's, or
+ * the surface is not one plane of 32-bit pixels, blue first, in rows the GPU can address.
+ */
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface)
+{
+#ifdef GALLIUM_FREEDRENO
+   struct redwood_drm_surface s = { .surface = surface };
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_B8G8R8A8_UNORM,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET,
+   };
+   struct winsys_handle handle = { .type = WINSYS_HANDLE_TYPE_FD };
+
+   if (gpu_fd < 0 || redwood_drm_surface(gpu_fd, &s) != 0)
+      return NULL;
+   if (s.pixel_format != 0x42475241 /* 'BGRA' */ || s.planes != 0)
+      return NULL;
+   /* (the surface comes in as Linux's buffers come in by file descriptor: see redwood-drm) */
+   templ.width0 = s.width;
+   templ.height0 = s.height;
+   handle.handle = surface;
+   handle.stride = s.row_bytes;
+   handle.offset = s.offset;
+   handle.size = s.size;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+#else
+   return NULL;
+#endif
+}
+
+
+struct pipe_screen *
+osmesa_create_screen(void);
+
+
+struct pipe_screen *
+osmesa_create_screen(void)
+{
+   struct sw_winsys *winsys;
+   struct pipe_screen *screen;
+
+#ifdef GALLIUM_FREEDRENO
+   screen = osmesa_create_gpu_screen();
+   if (screen)
+      return screen;
+#endif
+
+   /* We use a null software winsys since we always just render to ordinary
+    * driver resources.
+    */
+   winsys = null_sw_create();
+   if (!winsys)
+      return NULL;
+
+   /* Create llvmpipe or softpipe screen */
+   screen = sw_screen_create(winsys);
+   if (!screen) {
+      winsys->destroy(winsys);
+      return NULL;
+   }
+
+   /* Inject optional trace, debug, etc. wrappers */
+   return debug_screen_wrap(screen);
+}
diff -ruN -x *.rej -x *.orig -x Oops* -x __pycache__ -x air -x redwood-drm -x ci ref-26.2.5/mesa-26.2.5/src/gallium/targets/osmesa/test-render.cpp mesa-26.2.5/src/gallium/targets/osmesa/test-render.cpp
--- a/src/gallium/targets/osmesa/test-render.cpp	1970-01-01 08:00:00
+++ b/src/gallium/targets/osmesa/test-render.cpp	2026-10-23 14:09:00
@@ -0,0 +1,310 @@
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <array>
+#include <memory>
+
+#include <gtest/gtest.h>
+
+#include "GL/osmesa.h"
+#include "util/macros.h"
+#include "util/u_endian.h"
+#include "util/u_math.h"
+
+typedef struct {
+   unsigned format;
+   GLenum type;
+   int bpp;
+   uint64_t expected;
+} Params;
+
+class OSMesaRenderTestFixture : public testing::TestWithParam<Params> {};
+
+std::string
+name_params(const testing::TestParamInfo<Params> params) {
+   auto p = params.param;
+   std::string first, second;
+   switch (p.format) {
+   case OSMESA_RGBA:
+      first = "rgba";
+      break;
+   case OSMESA_BGRA:
+      first = "bgra";
+      break;
+   case OSMESA_RGB:
+      first = "rgb";
+      break;
+   case OSMESA_RGB_565:
+      first = "rgb_565";
+      break;
+   case OSMESA_ARGB:
+      first = "argb";
+      break;
+   }
+
+   switch (p.type) {
+   case GL_UNSIGNED_SHORT:
+      second = "unsigned_short";
+      break;
+   case GL_UNSIGNED_BYTE:
+      second = "unsigned_byte";
+      break;
+   case GL_FLOAT:
+      second = "float";
+      break;
+   case GL_UNSIGNED_SHORT_5_6_5:
+      second = "unsigned_short_565";
+      break;
+   }
+
+   return first + "_" + second;
+};
+
+TEST_P(OSMesaRenderTestFixture, Render)
+{
+   auto p = GetParam();
+   const int w = 2, h = 2;
+   uint8_t pixels[w * h * 8] = { 0 };
+
+   std::unique_ptr<osmesa_context, decltype(&OSMesaDestroyContext)> ctx{
+      OSMesaCreateContext(p.format, NULL), &OSMesaDestroyContext};
+   ASSERT_TRUE(ctx);
+
+   auto ret = OSMesaMakeCurrent(ctx.get(), &pixels, p.type, w, h);
+   ASSERT_EQ(ret, GL_TRUE);
+
+   glClearColor(0.25, 1.0, 0.5, 0.75);
+
+   uint64_t expected = p.expected;
+
+   /* All the formats other than 565 and RGB/byte are array formats, but our
+    * expected values are packed, so byte swap appropriately.
+    */
+   if (UTIL_ARCH_BIG_ENDIAN) {
+      switch (p.bpp) {
+      case 8:
+         expected = util_bswap64(expected);
+         break;
+
+      case 4:
+         expected = util_bswap32(expected);
+         break;
+
+      case 3:
+      case 2:
+         break;
+      }
+   }
+
+   glClear(GL_COLOR_BUFFER_BIT);
+   glFinish();
+
+#if 0 /* XXX */
+   for (unsigned i = 0; i < ARRAY_SIZE(pixels); i += 4) {
+      fprintf(stderr, "pixel %d: %02x %02x %02x %02x\n",
+              i / 4,
+              pixels[i + 0],
+              pixels[i + 1],
+              pixels[i + 2],
+              pixels[i + 3]);
+   }
+#endif
+
+   for (unsigned i = 0; i < w * h; i++) {
+      switch (p.bpp) {
+      case 2: {
+         uint16_t color = 0;
+         memcpy(&color, &pixels[i * p.bpp], p.bpp);
+         ASSERT_EQ(expected, color);
+         break;
+      }
+
+      case 3: {
+         uint32_t color = ((pixels[i * p.bpp + 0] << 0) |
+                           (pixels[i * p.bpp + 1] << 8) |
+                           (pixels[i * p.bpp + 2] << 16));
+         ASSERT_EQ(expected, color);
+         break;
+      }
+
+      case 4: {
+         uint32_t color = 0;
+         memcpy(&color, &pixels[i * p.bpp], p.bpp);
+         ASSERT_EQ(expected, color);
+         break;
+      }
+
+      case 8: {
+         uint64_t color = 0;
+         memcpy(&color, &pixels[i * p.bpp], p.bpp);
+         ASSERT_EQ(expected, color);
+         break;
+      }
+
+      default:
+         unreachable("bad bpp");
+      }
+   }
+}
