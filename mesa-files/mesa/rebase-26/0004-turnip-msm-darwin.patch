--- a/src/freedreno/vulkan/tu_knl_drm_msm.cc
+++ b/src/freedreno/vulkan/tu_knl_drm_msm.cc
@@ -1033,6 +1033,17 @@
 static VkResult
 msm_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
 {
+#ifdef __APPLE__
+   /* Turnip on redwood-drm: the buffer's memory is the user client's memory of type gem_handle */
+   if (placed_addr != NULL)
+      return vk_error(dev, VK_ERROR_MEMORY_MAP_FAILED);
+   void *mapped = redwood_drm_map(dev->fd, bo->gem_handle, bo->size);
+   if (mapped == MAP_FAILED)
+      return vk_error(dev, VK_ERROR_MEMORY_MAP_FAILED);
+   bo->map = mapped;
+   TU_RMV(bo_map, dev, bo);
+   return VK_SUCCESS;
+#endif
    uint64_t offset = tu_gem_info(dev, bo->gem_handle, MSM_INFO_GET_OFFSET);
    if (!offset)
       return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
--- a/src/util/cache_ops_aarch64.c
+++ b/src/util/cache_ops_aarch64.c
@@ -26,13 +26,33 @@
 #include "util/macros.h"
 #include "util/u_atomic.h"
 
+#ifdef __APPLE__
+#include <sys/sysctl.h>
+
+/* XNU leaves SCTLR_EL1.UCT clear, so CTR_EL0 traps at EL0: build its line-size fields from hw.cachelinesize. */
 static uint32_t
 get_ctr_el0(void)
 {
+   static uint32_t ctr_el0;
+   if (!ctr_el0) {
+      uint64_t line = 0;
+      size_t length = sizeof(line);
+      if (sysctlbyname("hw.cachelinesize", &line, &length, NULL, 0) != 0 || line < 16 || (line & (line - 1)))
+         line = 64;
+      uint32_t words_log2 = __builtin_ctzll(line) - 2;
+      ctr_el0 = (words_log2 << 24) | (words_log2 << 16) | words_log2;
+   }
+   return ctr_el0;
+}
+#else
+static uint32_t
+get_ctr_el0(void)
+{
    uint32_t ctr_el0;
    __asm("mrs\t%x0, ctr_el0" : "=r"(ctr_el0));
    return ctr_el0;
 }
+#endif
 
