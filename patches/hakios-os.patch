+/* MPIDR of core n / the core an MPIDR belongs to, by the map when there is one. */
+static uint64_t
+core_mpidr(const struct platform *p, int n)
+{
+	return p->mpidr_map != NULL ? p->mpidr_map[n] : (uint64_t)n << p->core_shift;
