 };
 
+/* MPIDR of core n / the core an MPIDR belongs to, by the map when there is one. */
+static uint64_t
+core_mpidr(const struct platform *p, int n)
+{
+	return p->mpidr_map != NULL ? p->mpidr_map[n] : (uint64_t)n << p->core_shift;
+}
+
+static int
+mpidr_core(const struct platform *p, uint64_t mpidr)
+{
+	if (p->mpidr_map == NULL) return (int)(mpidr >> p->core_shift);
+	for (int i = 0; i < p->cores; i++) if (p->mpidr_map[i] == mpidr) return i;
+	return -1;
+}
