 	mkdir -p root/fw
-	install -m 0644 ../fw-audio/adsp.mdt ../fw-audio/adsp.b0[2-9] ../fw-audio/adsp.b[1-9][0-9] root/fw/
+	install -m 0644 ../fw-audio/adsp.mdt ../fw-audio/adsp.b0[0-9] ../fw-audio/adsp.b[1-9][0-9] root/fw/
+fi
+# SM8750's audio DSP also has a device tree of its own, its own signed image (Linux's
+# sun_adsp_resource: dtb_pas_id 0x24, q6_adsp_dtb_region): adsp_dtb.mdt and its b-files.
+if [ -n "$ADSP" ] && [ -f ../fw-audio/adsp_dtb.mdt ]; then
+	install -m 0644 ../fw-audio/adsp_dtb.mdt ../fw-audio/adsp_dtb.b0* root/fw/
+fi
+# the compute DSP of the same SoC (Linux's sun_cdsp_resource: pas_id 18, its tree
+# at pas 0x25) -- the cross-check for the audio DSP's release: adsp_fw=cdsp
+if [ -n "$ADSP" ] && [ -f ../fw-audio/cdsp.mdt ]; then
+	install -m 0644 ../fw-audio/cdsp.mdt ../fw-audio/cdsp.b0[0-9] ../fw-audio/cdsp.b[1-9][0-9] root/fw/
+	install -m 0644 ../fw-audio/cdsp_dtb.mdt ../fw-audio/cdsp_dtb.b0* root/fw/
 fi
