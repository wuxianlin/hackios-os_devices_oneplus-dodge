+/*
+ * A translation check (the AT instruction) without touching the address:
+ * reading unmapped space would fault the loader (the phone falls back to
+ * fastboot). Same pattern as XnuLoader.c in the firmware volume.
+ */
+static int
+mapped(uint64_t addr)
+{
+	uint64_t el, par;
+
+	__asm__ volatile ("mrs %0, CurrentEL" : "=r" (el));
+	if (el == 4) {
+		__asm__ volatile ("at s1e1r, %1; isb; mrs %0, par_el1" : "=r" (par) : "r" (addr) : "memory");
+	} else {
+		__asm__ volatile ("at s1e2r, %1; isb; mrs %0, par_el1" : "=r" (par) : "r" (addr) : "memory");
+	}
+	return (par & 1) == 0;
+}
+
+/*
+ * The Gunyah Resource Manager's message-queue capids: they are different every
+ * boot (allocated when the RM builds this VM), and the only place this boot's
+ * values live is the device tree ABL built -- the one with the RM's overlay.
+ * The FDT the firmware publishes is a small vendor-built one without it, so
+ * walk mapped memory for an FDT whose structure block carries the
+ * resource-manager node, and read reg = <tx_hi tx_lo rx_hi rx_lo> out of it.
+ */
+static int
+gunyah_rm_caps(uint64_t *tx, uint64_t *rx)
+{
+	static const efi_guid dtb_guid = { 0xb1b621d5, 0xf19c, 0x41a5, { 0x83, 0x0b, 0xd9, 0x15, 0x2c, 0x69, 0xaa, 0xe0 } };
+	const uint8_t *fdt = NULL;
+
+	for (uint64_t i = 0; ST->tables != NULL && i < ST->nr_tables && i < 32; i++) {
+		const efi_guid *g = &ST->tables[i].guid;
+
+		if (g->a == dtb_guid.a && g->b == dtb_guid.b && g->c == dtb_guid.c) {
+			uint64_t k;
+
+			for (k = 0; k < 8; k++) {
+				if (g->d[k] != dtb_guid.d[k]) {
+					break;
+				}
+			}
+			if (k == 8) {
+				fdt = (const uint8_t *)(uintptr_t)ST->tables[i].table;
+				break;
+			}
+		}
+	}
+	if (fdt == NULL || fdt[0] != 0xd0 || fdt[1] != 0x0d || fdt[2] != 0xfe || fdt[3] != 0xed) {
+		/* say which of the two it was: no DTB table at all, or one without
+		 * a usable header */
+		for (uint64_t i = 0; ST->tables != NULL && i < ST->nr_tables && i < 32; i++) {
+			const efi_guid *g = &ST->tables[i].guid;
+
+			print("gunyah: firmware table %d: %x-%x-%x-%x%x at %x\n", (int)i, (uint64_t)g->a, (uint64_t)g->b,
+			    (uint64_t)g->c, (uint64_t)g->d[0], (uint64_t)g->d[1], (uint64_t)(uintptr_t)ST->tables[i].table);
+		}
+		print("gunyah: %s (%d config tables)\n",
+		    fdt == NULL ? "no device tree in the firmware's configuration tables" : "the device table is not an FDT",
+		    ST->tables != NULL ? (int)ST->nr_tables : -1);
+		return 0;
+	}
+	print("gunyah: the firmware's FDT at %x, %x bytes; resource-manager node %s\n",
+	    (uint64_t)(uintptr_t)fdt,
+	    ((uint32_t)fdt[4] << 24) | ((uint32_t)fdt[5] << 16) | ((uint32_t)fdt[6] << 8) | fdt[7], "searched");
+			/* The boot shim parks the bootloader's x0..x3 and its own image
+	 * address on the page after the payload. Print them only: WHICH of
+	 * them (if any) carries this boot's device tree pointer is decided on
+	 * the host from the readings -- dereferencing or scanning from here
+	 * has faulted the loader three times (the hypervisor's stage-2 holes
+	 * are invisible to EL1 probing). */
+	{
+		struct payload_header *ph = (struct payload_header *)PAYLOAD_BASE;
+		uint64_t end = PAYLOAD_BASE + ((8 + (uint64_t)ph->size + 15) & ~15ULL);
+		const uint64_t *h = (const uint64_t *)(uintptr_t)((end + 0xfff) & ~0xfffULL);
+
+		print("gunyah: handoff x0=%x x1=%x x2=%x x3=%x image=%x\n",
+		    h[0], h[1], h[2], h[3], h[4]);
+		(void)fdt;
+		return 0;
+	}
+	uint32_t stru = ((uint32_t)fdt[8] << 24) | ((uint32_t)fdt[9] << 16) | ((uint32_t)fdt[10] << 8) | fdt[11];
+	uint32_t stru_size = ((uint32_t)fdt[36] << 24) | ((uint32_t)fdt[37] << 16) | ((uint32_t)fdt[38] << 8) | fdt[39];
+	const uint8_t *p = fdt + stru, *pend = p + stru_size;
+	const char *strs = (const char *)fdt +
+	    ((((uint32_t)fdt[12] << 24) | ((uint32_t)fdt[13] << 16) | ((uint32_t)fdt[14] << 8) | fdt[15]));
+
+	while (p + 4 <= pend) {
+		uint32_t tok = ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+
+		if (tok == 1) {                    /* BEGIN_NODE: the name is inline */
+			const char *name = (const char *)(p + 4);
+			uint64_t n = 0;
+
+			while (name[n] != 0 && &name[n + 1] < (const char *)pend) {
+				n++;
+			}
+			/* "qcom,resource-manager-rpc@" is 26 characters */
+			static const char want[] = "qcom,resource-manager-rpc@";
+			uint64_t m;
+
+			for (m = 0; m < 26 && m < n; m++) {
+				if (name[m] != want[m]) {
+					break;
+				}
+			}
+			if (m == 26) {
+				/* skip the name, then walk this node's properties for reg */
+				const uint8_t *q = (const uint8_t *)&name[n + 1];
+
+				q = (const uint8_t *)(((uintptr_t)q + 3) & ~(uintptr_t)3);
+				while (q + 12 <= pend) {
+					uint32_t t2 = ((uint32_t)q[0] << 24) | ((uint32_t)q[1] << 16) | ((uint32_t)q[2] << 8) | q[3];
+					uint32_t len, nameoff;
+
+					if (t2 == 2 || t2 == 1) {        /* END_NODE: done with the node */
+						break;
+					}
+					if (t2 != 3) {                   /* PROP */
+						break;
+					}
+					len = ((uint32_t)q[4] << 24) | ((uint32_t)q[5] << 16) | ((uint32_t)q[6] << 8) | q[7];
+					nameoff = ((uint32_t)q[8] << 24) | ((uint32_t)q[9] << 16) | ((uint32_t)q[10] << 8) | q[11];
+					const char *pn = &strs[nameoff];
+					const uint8_t *val = q + 12;
+
+					if (pn[0] == 'r' && pn[1] == 'e' && pn[2] == 'g' && pn[3] == 0 && len >= 16) {
+						*tx = ((uint64_t)val[0] << 56) | ((uint64_t)val[1] << 48) | ((uint64_t)val[2] << 40) |
+						    ((uint64_t)val[3] << 32) | ((uint64_t)val[4] << 24) | ((uint64_t)val[5] << 16) |
+						    ((uint64_t)val[6] << 8) | val[7];
+						*rx = ((uint64_t)val[8] << 56) | ((uint64_t)val[9] << 48) | ((uint64_t)val[10] << 40) |
+						    ((uint64_t)val[11] << 32) | ((uint64_t)val[12] << 24) | ((uint64_t)val[13] << 16) |
+						    ((uint64_t)val[14] << 8) | val[15];
+						return 1;
+					}
+					q = val + ((len + 3) & ~(uint32_t)3);
+				}
+				return 0;                           /* the node was there but had no reg we could use */
+			}
+			p = (const uint8_t *)&name[n + 1];
+			p = (const uint8_t *)(((uintptr_t)p + 3) & ~(uintptr_t)3);
+		} else if (tok == 2 || tok == 4) {  /* END_NODE / NOP */
+			p += 4;
+		} else if (tok == 3) {              /* PROP at top level (should not happen) */
+			uint32_t len = ((uint32_t)p[4] << 24) | ((uint32_t)p[5] << 16) | ((uint32_t)p[6] << 8) | p[7];
+
+			p += 12 + ((len + 3) & ~(uint32_t)3);
+		} else {
+			break;
+		}
+	}
+	return 0;
+}
