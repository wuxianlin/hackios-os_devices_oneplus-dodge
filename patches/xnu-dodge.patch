+#ifndef _MINI_IOSURFACE_ABI_H
+#define _MINI_IOSURFACE_ABI_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define MINISURF_MAX_PLANES     4
+#define MINISURF_RESULT_MAX     0xa68           /* iOS 16.5 result capacity */
+
+/* Internal plane description and iOS 16.5 wire layout (0x80 bytes). */
+struct minisurf_plane {
+	uint32_t width;                         /* 0x00 */
+	uint32_t height;                        /* 0x04 */
+	uint32_t reserved08;
+	uint32_t offset;                        /* 0x0c from the base address */
+	uint32_t bytesPerRow;                   /* 0x10 */
+	uint32_t size;                          /* 0x14 */
+	uint16_t bytesPerElement;               /* 0x18 */
+	uint8_t  elementWidth;                  /* 0x1a */
+	uint8_t  elementHeight;                 /* 0x1b */
+	uint8_t  componentCount;                /* 0x1c */
+	uint8_t  addressFormat;                 /* 0x1d */
+	uint8_t  reserved1e[2];
+	uint8_t  componentBitDepth[4];          /* 0x20 */
+	uint8_t  componentBitOffset[4];         /* 0x24 */
+	uint8_t  componentName[4];              /* 0x28 */
+	uint8_t  componentType[4];              /* 0x2c */
+	uint8_t  componentRange[4];             /* 0x30 */
+	uint8_t  reserved34[0x20];
+	uint8_t  compression;                   /* 0x54: 1 = compressed, then there is no base address */
+	uint8_t  reserved55[0x1b];
+	uint32_t extendedPixels[4];             /* 0x70 */
+};
+
+/* Internal description and iOS 16.5 result header, followed by at least one plane. */
+struct minisurf_result {
+	uint64_t base;                          /* 0x00 where the memory is mapped in the client */
+	uint64_t shared;                        /* 0x08 struct minisurf_shared, mapped in the client */
+	uint64_t aux;                           /* 0x10 struct minisurf_aux, mapped in the client */
+	uint32_t sid;                           /* 0x18 */
+	uint32_t allocSize;                     /* 0x1c */
+	uint32_t width;                         /* 0x20 */
+	uint32_t height;                        /* 0x24 */
+	uint32_t bytesPerRow;                   /* 0x28 */
+	uint32_t offset;                        /* 0x2c */
+	uint32_t pixelFormat;                   /* 0x30 */
+	uint32_t reserved34;
+	uint32_t planeCount;                    /* 0x38 */
+	uint32_t reserved3c;
+	uint16_t bytesPerElement;               /* 0x40 */
+	uint8_t  elementWidth;                  /* 0x42 */
+	uint8_t  elementHeight;                 /* 0x43 */
+	uint32_t cacheMode;                     /* 0x44 */
+	uint32_t lockSeed;                      /* 0x48 the client keeps the seed of its last lock here */
+	uint8_t  subsampling;                   /* 0x4c */
+	uint8_t  prohibitUseCount;              /* 0x4d */
+	uint16_t reserved4e;
+	uint32_t parentID;                      /* 0x50 */
+	uint32_t sliceCount;                    /* 0x54 */
+	uint64_t traceID;                       /* 0x58 */
+	uint64_t protectionOptions;             /* 0x60 */
+};
+
+
+/* The internal description retains 20F66 fields; 23G90 widens its wire sizes. */
+enum minisurf_abi { MINISURF_UNCLAIMED, MINISURF_ABI16, MINISURF_ABI26 };
+
+static inline minisurf_abi
+minisurfInitABI(uint32_t size)
+{
+    return size == 0x18 ? MINISURF_ABI16 : size == 0x28 ? MINISURF_ABI26 : MINISURF_UNCLAIMED;
+}
+
+static inline void
+minisurfPut32(uint8_t * out, unsigned offset, uint32_t value)
+{
+    __builtin_memcpy(out + offset, &value, sizeof(value));
+}
+
+static inline void
+minisurfPut64(uint8_t * out, unsigned offset, uint64_t value)
+{
+    __builtin_memcpy(out + offset, &value, sizeof(value));
+}
+
+static inline bool
+minisurfInitReply(void * output, uint32_t size, uint32_t allocMask, uint32_t rowMask, uint32_t maxDimension)
+{
+    minisurf_abi abi = minisurfInitABI(size);
+    if (output == NULL || abi == MINISURF_UNCLAIMED) {
+        return false;
+    }
+    uint8_t * out = (uint8_t *) output;
+    __builtin_memset(out, 0, size);
+    minisurfPut32(out, 0, allocMask);
+    minisurfPut32(out, 4, rowMask);
+    uint16_t version = 1;
+    if (abi == MINISURF_ABI26) {
+        minisurfPut64(out, 8, (uint64_t) maxDimension * 16);
+        minisurfPut64(out, 0x10, maxDimension);
+        minisurfPut64(out, 0x18, maxDimension);
+        __builtin_memcpy(out + 0x22, &version, sizeof(version));
+    } else {
+        minisurfPut32(out, 8, maxDimension * 16);
+        minisurfPut32(out, 0xc, maxDimension);
+        minisurfPut32(out, 0x10, maxDimension);
+        __builtin_memcpy(out + 0x16, &version, sizeof(version));
+    }
+    return true;
+}
+
+static inline uint32_t
+minisurfResultSize(minisurf_abi abi, uint32_t planeCount)
+{
+    if (planeCount > MINISURF_MAX_PLANES) {
+        return 0;
+    }
+    uint32_t planes = planeCount ? planeCount : 1;
+    return abi == MINISURF_ABI26 ? 0x88 + planes * 0x98 :
+        abi == MINISURF_ABI16 ? sizeof(minisurf_result) + planes * sizeof(minisurf_plane) : 0;
+}
+
+/* Returns zero before writing if the output cannot hold the complete description. */
+static inline uint32_t
+minisurfWriteResult(void * output, uint32_t capacity, minisurf_abi abi,
+    const minisurf_result * info, const minisurf_plane * planes)
+{
+    uint32_t size = minisurfResultSize(abi, info->planeCount);
+    if (output == NULL || size == 0 || capacity < size) {
+        return 0;
+    }
+    uint8_t * out = (uint8_t *) output;
+    if (abi == MINISURF_ABI16) {
+        __builtin_memcpy(out, info, sizeof(*info));
+        __builtin_memcpy(out + sizeof(*info), planes, size - sizeof(*info));
+        return size;
+    }
+    __builtin_memset(out, 0, size);
+    minisurfPut64(out, 0, info->base);
+    minisurfPut64(out, 8, info->shared);
+    minisurfPut64(out, 0x10, info->aux);
+    minisurfPut32(out, 0x18, info->sid);
+    minisurfPut64(out, 0x20, info->allocSize);
+    minisurfPut64(out, 0x28, info->width);
+    minisurfPut64(out, 0x30, info->height);
+    minisurfPut64(out, 0x38, info->bytesPerRow);
+    minisurfPut64(out, 0x40, info->offset);
+    minisurfPut32(out, 0x48, info->pixelFormat);
+    minisurfPut32(out, 0x58, info->planeCount);
+    __builtin_memcpy(out + 0x60, &info->bytesPerElement, 4);
+    minisurfPut32(out, 0x64, info->cacheMode);
+    minisurfPut32(out, 0x68, info->lockSeed);
+    out[0x6c] = info->subsampling;
+    out[0x6d] = info->prohibitUseCount;
+    minisurfPut32(out, 0x70, info->parentID);
+    minisurfPut32(out, 0x74, info->sliceCount);
+    minisurfPut64(out, 0x78, info->traceID);
+    minisurfPut64(out, 0x80, info->protectionOptions);
+    uint32_t count = info->planeCount ? info->planeCount : 1;
+    for (uint32_t i = 0; i < count; ++i) {
+        uint8_t * p = out + 0x88 + i * 0x98;
+        minisurfPut64(p, 0, planes[i].width);
+        minisurfPut64(p, 8, planes[i].height);
+        minisurfPut64(p, 0x18, planes[i].offset);
+        minisurfPut64(p, 0x20, planes[i].bytesPerRow);
+        minisurfPut64(p, 0x28, planes[i].size);
+        __builtin_memcpy(p + 0x30, &planes[i].bytesPerElement, 0x1c);
+        p[0x6c] = planes[i].compression;
+        __builtin_memcpy(p + 0x88, planes[i].extendedPixels, sizeof(planes[i].extendedPixels));
+    }
+    return size;
+}
+
+static inline bool
+minisurfCanMap(minisurf_abi surface, minisurf_abi client)
+{
+    return (client == MINISURF_ABI16 || client == MINISURF_ABI26) &&
+        (surface == MINISURF_UNCLAIMED || surface == client);
+}
+
+static inline uint8_t *
+minisurfAttachments(void * shared, minisurf_abi abi)
+{
+    return (uint8_t *) shared + (abi == MINISURF_ABI26 ? 0x34 : 0x30);
+}
+
+static inline void
+minisurfSetYCbCrMatrix(void * shared, minisurf_abi abi, uint32_t value)
+{
+    if (abi == MINISURF_ABI26) {
+        ((uint8_t *) shared)[0x6e] = (uint8_t) value;
+    } else {
+        minisurfPut32((uint8_t *) shared, 0x24, value);
+    }
+}
+
+/* 23G90 selector 27 adds seven attachment fields and moves the request suffix. */
+static inline bool
+minisurfBulkInput(minisurf_abi abi, const uint8_t * in, size_t inSize,
+    uint64_t * size, uint64_t * mask, uint32_t * sid)
+{
+    unsigned suffix = abi == MINISURF_ABI26 ? 0x88 : 0x70;
+    unsigned limit = abi == MINISURF_ABI26 ? 0x84 : 0x70;
+    if (in == NULL || inSize < suffix + 0x18) {
+        return false;
+    }
+    __builtin_memcpy(size, in + suffix, sizeof(*size));
+    __builtin_memcpy(mask, in + suffix + 8, sizeof(*mask));
+    __builtin_memcpy(sid, in + suffix + 16, sizeof(*sid));
+    return *size <= limit;
+}
+
+static inline void
+minisurfApplyBulk(void * shared, minisurf_abi abi, const uint8_t * in, uint64_t size, uint64_t mask)
+{
+    static const struct { uint8_t from, to; } fields[] = {
+        {0x00, 0x20}, {0x20, 0x30}, {0x30, 0x38}, {0x38, 0x39}, {0x39, 0x3a},
+        {0x3a, 0x3b}, {0x3b, 0x3c}, {0x3c, 0x3d}, {0x3d, 0x3e}, {0x3e, 0x3f},
+        {0x3f, 0x40}, {0x40, 0x58}, {0x58, 0x5c}, {0x5c, 0x64}, {0x64, 0x65},
+        {0x68, 0x70}, {0x70, 0x74}, {0x65, 0x66}, {0x66, 0x67}, {0x74, 0x80},
+        {0x80, 0x82}, {0x82, 0x84},
+    };
+    uint8_t * out = minisurfAttachments(shared, abi);
+    unsigned count = abi == MINISURF_ABI26 ? 22 : 15;
+    for (unsigned i = 0; i < count; ++i) {
+        if ((mask & (1ULL << i)) && fields[i].to <= size) {
+            __builtin_memcpy(out + fields[i].from, in + fields[i].from, fields[i].to - fields[i].from);
+        }
+    }
+}
+
+#endif /* _MINI_IOSURFACE_ABI_H */
diff --git a/iokit/Kernel/MiniIOSurfaceABI.inc b/iokit/Kernel/MiniIOSurfaceABI.inc
new file mode 100644
index 0000000..9c0239b
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurfaceABI.inc
@@ -0,0 +1,57 @@
+/* User-client serialization and the fields whose shared-page offsets vary by ABI. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(struct minisurf_client_ref * ref, bool known, IOExternalMethodArguments * args)
+{
+	MiniIOSurface * s = ref->surface;
+	struct minisurf_result result = s->info;
+	mach_vm_address_t address = ref->map->getAddress();
+
+	result.shared = address;
+	result.aux = address + MINISURF_AUX_OFFSET;
+	result.base = known ? ~0ULL : s->client == NULL ? address + PAGE_SIZE :
+	    ref->pixelMap != NULL ? ref->pixelMap->getAddress() : s->clientAddress;
+	uint32_t size = minisurfWriteResult(args->structureOutput, args->structureOutputSize, fABI, &result, s->planes);
+	if (size == 0) {
+		return kIOReturnBadArgument;
+	}
+	args->structureOutputSize = size;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodInit(IOExternalMethodArguments * args)
+{
+	minisurf_abi abi = minisurfInitABI(args->structureOutputSize);
+
+	IOLockLock(gSurfaceLock);
+	if ((fABI != MINISURF_UNCLAIMED && fABI != abi) || !minisurfInitReply(args->structureOutput,
+	    args->structureOutputSize, (uint32_t) PAGE_MASK, MINISURF_ROW_ALIGN - 1, MINISURF_MAX_DIMENSION)) {
+		IOLockUnlock(gSurfaceLock);
+		return kIOReturnBadArgument;
+	}
+	fABI = abi;
+	IOLockUnlock(gSurfaceLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodSetBulkAttachments(const uint8_t * in, size_t inSize)
+{
+	uint64_t size, mask;
+	uint32_t sid;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	IOLockLock(gSurfaceLock);
+	if (!minisurfBulkInput(fABI, in, inSize, &size, &mask, &sid)) {
+		IOLockUnlock(gSurfaceLock);
+		return kIOReturnBadArgument;
+	}
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		minisurfApplyBulk(ref->surface->shared(), fABI, in, size, mask);
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
diff --git a/iokit/Kernel/RedwoodBattery.cpp b/iokit/Kernel/RedwoodBattery.cpp
new file mode 100644
index 0000000..87223c2
--- /dev/null
+++ b/iokit/Kernel/RedwoodBattery.cpp
@@ -0,0 +1,230 @@
+/*
+ * RedwoodBattery: the phone's battery as iOS looks for it, an IOPMPowerSource.
+ *
+ * powerd finds every service of the class IOPMPowerSource (it calls the first "InternalBattery-0"),
+ * listens for its kIOPMMessageBatteryStatusHasChanged and then reads its properties: whether a
+ * battery is installed, CurrentCapacity and MaxCapacity (without both it gives up on the battery),
+ * whether a charger is connected and charging, voltage, current, cycles, the charger's details.
+ * From them it makes the power sources list (IOPSCopyPowerSourcesInfo) and posts its notifications,
+ * and everything else follows from that: the status bar's battery, the lock screen's "Charging",
+ * the Batteries widget, Settings > Battery.
+ *
+ * What the values are comes from the audio DSP's battery manager (bsd/dev/redwood_adsp.c,
+ * with adsp=1, unless battmgr=0), by way of bsd/dev/redwood_battery.c, which calls
+ * RedwoodBatteryReport() with every reading; the first one makes the service. Nothing here asks
+ * the charger anything or tells it anything.
+ *
+ * As on Apple's newer batteries, CurrentCapacity is the percentage that the fuel gauge shows (and
+ * MaxCapacity 100); the charges in mAh are AppleRawCurrentCapacity, AppleRawMaxCapacity (what the
+ * gauge has learnt a full charge to be), NominalChargeCapacity and DesignCapacity.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+
+/* The same as struct redwood_battery_state in bsd/sys/redwood_input.h, which is not seen from here. */
+struct redwood_battery_state {
+	uint32_t size;
+	int32_t percent_hundredths;
+	int32_t voltage_uv;
+	int32_t current_ua;             /* more than 0 while the battery takes charge */
+	int32_t temperature_hundredths;
+	int32_t present, external, status;
+	int32_t charge_uah, full_uah, design_uah, cycles;
+	int32_t usb_type;
+	int32_t usb_voltage_uv, usb_current_ua;
+};
+
+extern "C" void RedwoodBatteryReport(const void * state, unsigned size);
+
+class RedwoodBattery : public IOPMPowerSource
+{
+	OSDeclareDefaultStructors(RedwoodBattery);
+
+public:
+	void report(const struct redwood_battery_state * b);
+
+private:
+	void number(const char * key, long long value);
+	void flag(const char * key, bool value);
+	void object(const char * key, OSObject * value);
+};
+
+OSDefineMetaClassAndStructors(RedwoodBattery, IOPMPowerSource);
+
+static RedwoodBattery * battery;
+
+void
+RedwoodBattery::number(const char * key, long long value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+	OSNumber * n = OSNumber::withNumber((unsigned long long) value, 32);
+
+	if (symbol != NULL && n != NULL) {
+		setPSProperty(symbol, n);
+	}
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+RedwoodBattery::flag(const char * key, bool value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+RedwoodBattery::object(const char * key, OSObject * value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL && value != NULL) {
+		setPSProperty(symbol, value);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+/*
+ * What iOS calls the charger by (IOPSKeysPrivate.h's kIOPSFamilyCode*, iokit_family_err(sub_iokit_usb, n)),
+ * from Linux's POWER_SUPPLY_USB_TYPE_*, as the DSP gives it.
+ */
+static unsigned
+family_code(int usb_type)
+{
+	switch (usb_type) {
+	case 1: return 0xe0004000;      /* SDP, a computer's port: kIOPSFamilyCodeUSBHost */
+	case 2: return 0xe0004004;      /* DCP, a charger: kIOPSFamilyCodeUSBChargingPortDedicated */
+	case 3: return 0xe0004005;      /* CDP, a computer's charging port: kIOPSFamilyCodeUSBChargingPortDownstream */
+	case 5: return 0xe0004009;      /* USB-C: kIOPSFamilyCodeUSBCTypeC */
+	case 6: case 7: case 8: return 0xe000400a;      /* USB Power Delivery: kIOPSFamilyCodeUSBCPD */
+	default: return 0xe0004007;     /* kIOPSFamilyCodeUSBUnknown */
+	}
+}
+
+void
+RedwoodBattery::report(const struct redwood_battery_state * b)
+{
+	int percent = (b->percent_hundredths + 50) / 100;
+	bool charging = b->external && b->status == 1;          /* POWER_SUPPLY_STATUS_CHARGING */
+
+	percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	setBatteryInstalled(b->present != 0);
+	setExternalConnected(b->external != 0);
+	setExternalChargeCapable(b->external != 0);
+	setIsCharging(charging);
+	flag("FullyCharged", b->external && (b->status == 4 || percent == 100));    /* POWER_SUPPLY_STATUS_FULL */
+	flag("AppleRawExternalConnected", b->external != 0);
+	setCurrentCapacity((unsigned) percent);
+	setMaxCapacity(100);
+	setVoltage((unsigned) (b->voltage_uv / 1000));
+	setAmperage(b->current_ua / 1000);
+	number("InstantAmperage", b->current_ua / 1000);
+	number("Temperature", b->temperature_hundredths);
+	if (b->charge_uah > 0) {
+		number("AppleRawCurrentCapacity", b->charge_uah / 1000);
+	}
+	if (b->full_uah > 0) {
+		number("AppleRawMaxCapacity", b->full_uah / 1000);
+		number("NominalChargeCapacity", b->full_uah / 1000);
+	}
+	if (b->design_uah > 0) {
+		number("DesignCapacity", b->design_uah / 1000);
+	}
+	if (b->cycles > 0) {
+		setCycleCount((unsigned) b->cycles);
+	}
+
+	if (b->external) {
+		OSDictionary * adapter = OSDictionary::withCapacity(6);
+		long long mv = b->usb_voltage_uv / 1000, ma = b->usb_current_ua / 1000;
+		OSNumber * n;
+
+		if (adapter != NULL) {
+			if ((n = OSNumber::withNumber((unsigned long long) ((mv * ma + 500000) / 1000000), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsWattsKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) ma, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsAmperageKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) mv, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsVoltage, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) family_code(b->usb_type), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+				n->release();
+			}
+			adapter->setObject("IsWireless", kOSBooleanFalse);
+			object(kIOPMPSAdapterDetailsKey, adapter);
+			adapter->release();
+		}
+	} else {
+		OSDictionary * none = OSDictionary::withCapacity(1);
+		OSNumber * n = OSNumber::withNumber(0ULL, 32);    /* kIOPSFamilyCodeDisconnected */
+
+		if (none != NULL && n != NULL) {
+			none->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+			object(kIOPMPSAdapterDetailsKey, none);
+		}
+		OSSafeReleaseNULL(n);
+		OSSafeReleaseNULL(none);
+	}
+	updateStatus();
+}
+
+/* With every reading of the battery (bsd/dev/redwood_battery.c); the first one makes the service. One caller at a time. */
+void
+RedwoodBatteryReport(const void * state, unsigned size)
+{
+	const struct redwood_battery_state * b = (const struct redwood_battery_state *) state;
+	IOService * platform;
+
+	if (size != sizeof(struct redwood_battery_state) || b->size != sizeof(struct redwood_battery_state)) {
+		static bool said;
+
+		if (!said) {
+			said = true;
+			IOLog("RedwoodBattery: the battery's state is %u bytes, not %lu: bsd/sys/redwood_input.h and this file disagree\n",
+			    size, sizeof(struct redwood_battery_state));
+		}
+		return;
+	}
+	if (battery == NULL) {
+		RedwoodBattery * made = OSTypeAlloc(RedwoodBattery);
+
+		if ((platform = IOService::getPlatform()) == NULL || made == NULL || !made->init()) {
+			OSSafeReleaseNULL(made);
+			return;
+		}
+		made->report(b);        /* (the properties are there before anybody finds the service) */
+		if (!made->attach(platform)) {
+			made->release();
+			return;
+		}
+		made->setName("RedwoodBattery");
+		if (!made->start(platform)) {
+			made->detach(platform);
+			made->release();
+			return;
+		}
+		made->registerService();
+		battery = made;
+		IOLog("RedwoodBattery: the battery's power source is up: %d%%, %s\n", (b->percent_hundredths + 50) / 100,
+		    b->external ? (b->status == 1 ? "charging" : "on a charger, not charging") : "not on a charger");
+		return;
+	}
+	battery->report(b);
+}
diff --git a/iokit/Kernel/RedwoodWLAN.cpp b/iokit/Kernel/RedwoodWLAN.cpp
new file mode 100644
index 0000000..89d8840
--- /dev/null
+++ b/iokit/Kernel/RedwoodWLAN.cpp
@@ -0,0 +1,137 @@
+/*
+ * RedwoodWLAN: the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/redwood_net.c) and has no IOKit object behind
+ * it of its own; iOS looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which bsd/dev/redwood_apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ * So: a controller of the class IO80211Controller under the platform, and below it one object
+ * that is both, an IONetworkInterface with wifid's properties. Both classes are ours, named as
+ * IO80211Family and IONetworkingFamily name theirs; neither has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void RedwoodWLANStart(const char * interface, const uint8_t * address);
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class RedwoodWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(RedwoodWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+RedwoodWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("RedwoodWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+RedwoodWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	RedwoodWLAN * wlan = OSTypeAlloc(RedwoodWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("RedwoodWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	if ((controller = (IO80211Controller *) publish(controller, platform, "RedwoodWLANController")) == NULL) {
+		wlan->release();
+		IOLog("RedwoodWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "RedwoodWLAN") == NULL) {
+		IOLog("RedwoodWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
